{
  "appId": "com.TrierOS.app",
  "productName": "Trier OS",
  "copyright": "Copyright Â© 2026 Doug Trier",
  "directories": {
    "buildResources": "electron/icons",
    "output": "electron-dist"
  },
  "afterPack": "./electron/afterPack.js",
  "msiProjectCreated": "./electron/msi-preservation.js",
  "asar": false,
  "npmRebuild": false,
  "nodeGypRebuild": false,
  "buildDependenciesFromSource": false,
  "files": [
    "dist/**/*",
    "src/**/*",
    "electron/**/*",
    "server/**/*",
    "public/assets/**/*",
    "node_modules/**/*",
    "package.json",
    "LICENSE",
    "TRADEMARKS.md",
    "openssl.cmd",
    "tls-runtime/**/*",
    "!node_modules/.cache/**/*",
    "!node_modules/.package-lock.json",
    "!server/data/**/*",
    "!server/test_db.js",
    "!server/test-integrations.js",
    "!server/*.db",
    "!server/*.sqlite",
    "!server/*.sqlite3",
    "!**/.sync_key",
    "!**/.env",
    "!**/*.key",
    "!**/first_login.txt",
    "!**/*.map",
    "!**/.git/**/*"
  ],
  "extraResources": [
    {
      "from": "data",
      "to": "seed-data",
      "filter": [
        "**/*.db",
        "plants.json",
        "branding.json",
        "corporate_leadership.json",
        "!certs/**/*",
        "!edge_keys/**/*",
        "!snapshots/**/*",
        "!**/.sync_key",
        "!**/*.key",
        "!**/*.db-shm",
        "!**/*.db-wal",
        "!**/*SNAP*",
        "!backups/**/*",
        "!trier_auth.db",
        "!trier_chat.db",
        "!log.db",
        "!studio_log.db",
        "!local-sqlite.db",
        "!trier_os.db"
      ]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "msi",
        "arch": ["x64"]
      },
      {
        "target": "zip",
        "arch": ["x64"]
      }
    ],
    "icon": "electron/icons/icon.ico",
    "artifactName": "TrierOS-Setup-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": true,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "include": "electron/installer.nsh",
    "installerIcon": "electron/icons/icon.ico",
    "uninstallerIcon": "electron/icons/icon.ico",
    "installerHeaderIcon": "electron/icons/icon.ico",
    "installerSidebar": "electron/icons/installerSidebar.bmp",
    "uninstallerSidebar": "electron/icons/installerSidebar.bmp",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Trier OS",
    "menuCategory": "Trier OS"
  },
  "msi": {
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "perMachine": true,
    "shortcutName": "Trier OS"
  },
  "publish": null
}
